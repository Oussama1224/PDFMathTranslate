# Copy to .env and adjust. Every PT2EN_* variable is optional.

# ---------------------------------------------------------------- translation
# Default engine: anthropic | openai | deepl | argos | demo
PT2EN_TRANSLATOR=anthropic
ANTHROPIC_API_KEY=
PT2EN_ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max  (higher = more careful, slower, more tokens)
PT2EN_ANTHROPIC_EFFORT=high
# "default" enables server-side refusal fallbacks; use "none" behind gateways that reject the beta
PT2EN_ANTHROPIC_FALLBACKS=default

# OpenAI-compatible endpoints (OpenAI, Azure, OpenRouter, vLLM, Ollama...)
OPENAI_API_KEY=
# Model: empty = gpt-4o (OpenAI) or meta/llama-3.3-70b-instruct (NVIDIA)
PT2EN_OPENAI_MODEL=
PT2EN_OPENAI_BASE_URL=
# NVIDIA (build.nvidia.com): set PT2EN_TRANSLATOR=openai and your nvapi-... key;
# the endpoint is selected automatically. Optionally pick a model from the catalog.
# NVIDIA_API_KEY=nvapi-...
# PT2EN_OPENAI_MAX_TOKENS=4096

DEEPL_API_KEY=

# Defaults for new jobs (the web UI can override them per document)
# academic | technical | literal
PT2EN_STYLE=academic
# en-GB | en-US
PT2EN_ENGLISH_VARIANT=en-GB
PT2EN_PRESERVE_TERMINOLOGY=true
PT2EN_LOCALIZE_NUMBERS=false
PT2EN_EXTRACT_GLOSSARY=true
PT2EN_TRANSLATION_CONCURRENCY=4
PT2EN_BATCH_MAX_CHARS=5000

# ------------------------------------------------------------------------ OCR
# tesseract | none
PT2EN_OCR_ENGINE=tesseract
PT2EN_OCR_LANGUAGES=por+eng
PT2EN_OCR_MIN_CONFIDENCE=55
PT2EN_OCR_DPI=300
PT2EN_TRANSLATE_IMAGES=true
# Only needed when Tesseract is not found automatically. Executable or folder;
# on Windows use forward slashes and no quotes, e.g. D:/Tesseract/tesseract.exe
# PT2EN_TESSERACT_CMD=/usr/bin/tesseract

# --------------------------------------------------------------------- layout
PT2EN_REUSE_ORIGINAL_FONTS=true
PT2EN_MIN_FONT_SCALE=0.72
PT2EN_HARD_MIN_FONT_SCALE=0.5
# serif | sans
PT2EN_SCAN_FONT_FAMILY=serif
# Extra font directories (os.pathsep separated)
PT2EN_FONT_DIRS=
# heuristic | doclayout (needs: pip install "pt2en-translator[layout]")
PT2EN_LAYOUT_DETECTOR=heuristic

# ------------------------------------------------------------------------- QA
# fix | report | off
PT2EN_QA_REVIEW=fix
PT2EN_QA_OCR_IMAGES=true
PT2EN_QA_MAX_REPAIR_ROUNDS=1

# --------------------------------------------------------------------- server
PT2EN_HOST=0.0.0.0
PT2EN_PORT=8000
PT2EN_DATA_DIR=./data
PT2EN_MAX_UPLOAD_MB=100
PT2EN_MAX_PAGES=500
PT2EN_MAX_CONCURRENT_JOBS=2
PT2EN_JOB_TTL_HOURS=72
# Optional shared secret; clients send "Authorization: Bearer <token>"
PT2EN_ACCESS_TOKEN=
PT2EN_CORS_ORIGINS=
PT2EN_LOG_LEVEL=INFO
